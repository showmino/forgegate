{
  // Only for the editor and `npm run typecheck`; Docusaurus builds the site itself.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets baseUrl, which TypeScript 6 deprecates.
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
